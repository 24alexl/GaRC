# Neo4j Database Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=garc2026password

# LLM Provider Configuration: "openrouter", "gemini", or "ollama"
LLM_PROVIDER=openrouter

# OpenRouter Settings (Recommended fast model: google/gemini-2.0-flash-001 or meta-llama/llama-3.1-8b-instruct)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini Settings (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Settings (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
